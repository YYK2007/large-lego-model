# Copy to .env. Never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
REBRICKABLE_API_KEY=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Demo: user feedback replaces post-build Gemini visual review. Set true to restore it.
PHOTON_VISUAL_REVIEW_ENABLED=false
# Public HTTPS origin forwarding ONLY to 127.0.0.1:3002 (signed read-only guide).
# Never expose the private API on 3001 or the Vite development server.
# Leave empty for local work.
PUBLIC_BASE_URL=
PORT=3001
